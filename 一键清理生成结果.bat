@echo off
chcp 65001 >nul
title 一键清理生成结果

echo ================================================
echo    警告：此操作将清空 "生成结果" 文件夹下的所有数据！
echo ================================================
echo.

set /p choice="确认要清除上次生成的痕迹吗？(Y/N): "
if /i "%choice%" neq "Y" (
    echo.
    echo 已取消清理操作。
    pause
    exit
)

echo.
echo 正在清理中...
if exist "生成结果" (
    rd /s /q "生成结果"
    echo 清理完成！所有旧生成的文档已被完全彻底清除。
) else (
    echo 没有找到 "生成结果" 文件夹，无需清理。
)

echo.
echo ================================================
pause
